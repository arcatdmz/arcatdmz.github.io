{
  "name": "junkato.jp",
  "private": true,
  "version": "1.1.0",
  "description": "Source code of https://junkato.jp",
  "main": "index.js",
  "scripts": {
    "bibtex": "bibtex-tidy --no-numeric --no-tab --no-align --no-sort --no-escape --sort-fields --tidy-comments --modify src/junkato.bib",
    "build": "npm run assets && next build --webpack && node --import tsx scripts/finalize-export.ts",
    "clean": "del-cli .next out dist build public site/generated \"pages/**/*.localized.tsx\"",
    "dev": "node --import tsx scripts/dev.ts",
    "prettify": "node --import tsx scripts/format-imports.ts --write && prettier --write \"pages/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"site/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,mts}\" \"src/**/*.{json,less,ts}\" \"*.{js,json,ts}\"",
    "test": "npm run typecheck && npm run test:unit -- --runInBand && npm run test:verifier",
    "routes": "node --import tsx scripts/prepare-routes.ts",
    "assets": "node --import tsx scripts/prepare-assets.ts",
    "typecheck": "node --import tsx scripts/prepare-assets.ts --ensure-data && tsc --noEmit",
    "test:unit": "jest",
    "preview": "node --import tsx scripts/serve-static.ts",
    "test:verifier": "node --import tsx --test tests/*.test.mts",
    "test:parity": "node --import tsx scripts/verify-site.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcatdmz/arcatdmz.github.io.git"
  },
  "keywords": [],
  "author": "Jun Kato <i@junkato.jp> (https://junkato.jp)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arcatdmz/arcatdmz.github.io/issues"
  },
  "homepage": "https://github.com/arcatdmz/arcatdmz.github.io#readme",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@orcid/bibtex-parse-js": "0.0.25",
    "@playwright/test": "1.65.0",
    "@types/jest": "^30.0.0",
    "@types/nprogress": "0.2.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semantic-ui": "^2.2.9",
    "autoprefixer": "10.6.2",
    "babel-loader": "^10.1.1",
    "bibtex-tidy": "^1.15.1",
    "del": "^7.1.0",
    "del-cli": "^8.0.1",
    "glob": "^14.0.4",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-less": "^5.0.0",
    "gulp-replace": "^1.1.4",
    "jest": "^30.5.2",
    "less": "4.9.1",
    "mkdirp": "^3.0.1",
    "moment": "^2.31.0",
    "parse5": "8.1.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "prettier": "^3.9.10",
    "purgecss": "9.1.0",
    "rss": "^1.2.2",
    "sharp": "^0.35.5",
    "sitemap": "^10.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "devicon": "^2.18.0",
    "fomantic-ui": "^2.9.4",
    "html-react-parser": "6.1.9",
    "jquery": "3.7.1",
    "next": "16.4.5",
    "nprogress": "0.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-fomantic-ui": "3.0.2"
  }
}
