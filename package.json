{
  "name": "junkato.jp",
  "private": true,
  "version": "1.1.0",
  "description": "Source code of https://junkato.jp",
  "main": "index.js",
  "scripts": {
    "bibtex": "bibtex-tidy --no-numeric --no-tab --no-align --no-sort --no-escape --sort-fields --tidy-comments --modify src/junkato.bib",
    "build": "npm run assets && next build --webpack && node --import tsx scripts/finalize-export.ts",
    "clean": "del-cli .next out dist build public site/generated",
    "dev": "node --import tsx scripts/dev.ts",
    "prettify": "prettier --write \"pages/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"site/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,mts}\" \"src/**/*.{json,less,ts}\" \"*.{js,json,ts}\"",
    "test": "npm run typecheck && npm run test:unit -- --runInBand && npm run test:verifier",
    "assets": "node --import tsx scripts/prepare-assets.ts",
    "typecheck": "node --import tsx scripts/prepare-assets.ts --ensure-data && tsc --noEmit",
    "test:unit": "jest",
    "preview": "node --import tsx scripts/serve-static.ts",
    "test:verifier": "node --import tsx --test tests/*.test.mts",
    "test:parity": "node --import tsx scripts/verify-site.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcatdmz/arcatdmz.github.io.git"
  },
  "keywords": [],
  "author": "Jun Kato <i@junkato.jp> (https://junkato.jp)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arcatdmz/arcatdmz.github.io/issues"
  },
  "homepage": "https://github.com/arcatdmz/arcatdmz.github.io#readme",
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-class-properties": "^7.24.7",
    "@babel/preset-env": "^7.23.3",
    "@orcid/bibtex-parse-js": "0.0.25",
    "@playwright/test": "1.64.0",
    "@types/jest": "^29.5.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semantic-ui": "^2.2.9",
    "autoprefixer": "10.4.19",
    "babel-loader": "^9.1.3",
    "bibtex-tidy": "^1.11.0",
    "del": "^7.1.0",
    "del-cli": "^6.0.0",
    "glob": "^10.3.10",
    "gulp": "^5.0.0",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-less": "^5.0.0",
    "gulp-replace": "^0.6.1",
    "jest": "^29.7.0",
    "less": "4.1.2",
    "mkdirp": "^3.0.1",
    "moment": "^2.29.4",
    "parse5": "8.0.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.5",
    "prettier": "^3.1.0",
    "purgecss": "7.0.2",
    "rss": "^1.2.2",
    "sharp": "^0.33.4",
    "sitemap": "^8.0.0",
    "ts-jest": "^29.3.4",
    "tsx": "4.23.15",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "devicon": "^2.15.1",
    "fomantic-ui": "^2.9.4",
    "html-react-parser": "6.1.8",
    "jquery": "3.2.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
